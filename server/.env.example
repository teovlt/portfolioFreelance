MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio
JWT_SECRET=change-me-to-a-long-random-stringme
FRONTEND_URL=http://localhost:5173
PORT=4000

# Where images uploaded from the dashboard are stored
UPLOAD_DIR=uploads

# Formspree form that emails you when a review is submitted (optional;
# left unset = no email). Same service as the site's contact form.
FORMSPREE_ENDPOINT=https://formspree.io/f/<form-id>
